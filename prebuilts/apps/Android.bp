android_app_import {
    apk: "NexusLauncherRelease.apk",
    name: "NexusLauncherRelease",
    overrides: ["Launcher3", "Launcher3QuickStep", "TrebuchetQuickStep"],
	presigned: true,
	preprocessed: true,
	dex_preopt: {
		enabled: false,
	},
	privileged: true,
	system_ext_specific: true,
}
